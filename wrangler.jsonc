{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takwahdigital-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "takwahdigital-content",
      "database_id": "local"
    }
  ],

  "r2_buckets": [
    {
      "binding": "TAKWAH_ASSETS",
      "bucket_name": "takwahdigital-assets"
    }
  ]
}