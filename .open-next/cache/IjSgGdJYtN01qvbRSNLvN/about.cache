{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"},"segmentPaths":["/_tree","/_full","/about/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2_yzi-uknwj-2.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2eg0ks0feyohg.js\" async=\"\"></script><script src=\"/_next/static/chunks/3e4keds9ktjdu.js\" async=\"\"></script><script src=\"/_next/static/chunks/2gefo9ja1l2mo.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0rftioeh48hpg.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mpnoxox0-4cg.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/30rchy52na1az.js\" async=\"\" crossorigin=\"\"></script><title>Takwah Digital | AI-Powered Digital Marketing</title><meta name=\"description\" content=\"Takwah Digital — AI-powered social media strategy, content creation, paid advertising, digital marketing, and marketing analytics.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-white text-[#0D1A63]\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex min-h-screen flex-col\"><div class=\"flex-1\"><header class=\"sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur\"><nav class=\"mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8\"><a class=\"text-xl font-bold tracking-tight text-[#0D1A63]\" href=\"/\">Takwah<span class=\"text-[#F68048]\"> Digital</span></a><div class=\"hidden items-center gap-5 lg:flex\"><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/\">Home</a><a class=\"relative py-2 text-sm font-medium transition text-[#2845D6]\" href=\"/about\">About<span class=\"absolute -bottom-1 left-0 right-0 mx-auto h-0.5 w-5 rounded-full bg-[#F68048]\"></span></a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/services\">Services</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/portfolio\">Portfolio</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/case-studies\">Case Studies</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/articles\">Articles</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/certificates\">Certificates</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/contact\">Contact</a><a class=\"ml-2 rounded-lg bg-[#2845D6] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#1A2CA3]\" href=\"/contact\">Let&#x27;s Work Together</a></div><button type=\"button\" aria-label=\"Open menu\" aria-expanded=\"false\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-[#0D1A63] transition hover:bg-slate-50 lg:hidden\"><span class=\"sr-only\">Open menu</span><div class=\"space-y-1.5\"><span class=\"block h-0.5 w-5 bg-current transition \"></span><span class=\"block h-0.5 w-5 bg-current transition \"></span><span class=\"block h-0.5 w-5 bg-current transition \"></span></div></button></nav></header><main class=\"bg-white text-[#0D1A63]\"><section class=\"relative overflow-hidden bg-slate-50\"><div class=\"absolute -right-40 -top-40 h-96 w-96 rounded-full bg-[#2845D6]/10 blur-3xl\"></div><div class=\"absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-[#F68048]/10 blur-3xl\"></div><div class=\"relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8 lg:py-28\"><div class=\"max-w-4xl\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">About Takwah Digital</p><h1 class=\"mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl\">Turning digital marketing ideas into<!-- --> <span class=\"text-[#2845D6]\">strategic, creative and measurable work.</span></h1><p class=\"mt-6 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl\">Takwah Digital is my professional portfolio and digital marketing platform, focused on social media strategy, content creation, paid advertising, and marketing analytics.</p></div></div></section><section class=\"py-20 sm:py-24\"><div class=\"mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8\"><div><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Who I Am</p><h2 class=\"mt-3 text-3xl font-bold tracking-tight sm:text-4xl\">A digital marketer focused on the intersection of creativity, technology and data.</h2><div class=\"mt-6 space-y-5 text-base leading-8 text-slate-600\"><p>I work across social media marketing, content creation, digital advertising, and marketing analytics to help brands communicate more effectively in digital environments.</p><p>My approach combines creative production with strategic thinking and performance measurement. Rather than treating content, advertising, and analytics as separate activities, I look at how they work together as part of a broader digital marketing system.</p><p>I also use AI-powered tools to improve research, ideation, content workflows, creative development, and marketing analysis while keeping human strategy and judgment at the center.</p></div></div><div class=\"rounded-3xl bg-[#0D1A63] p-8 text-white shadow-xl sm:p-10\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Professional Focus</p><h3 class=\"mt-5 text-2xl font-bold leading-tight sm:text-3xl\">AI-Powered Social Media Strategist, Content Creator &amp; Digital Marketing Analytics Specialist</h3><div class=\"mt-8 h-px bg-white/15\"></div><dl class=\"mt-8 space-y-6\"><div><dt class=\"text-sm text-blue-200\">Focus</dt><dd class=\"mt-1 font-semibold\">Social Media &amp; Digital Marketing</dd></div><div><dt class=\"text-sm text-blue-200\">Approach</dt><dd class=\"mt-1 font-semibold\">Strategy + Creativity + Analytics</dd></div><div><dt class=\"text-sm text-blue-200\">Technology</dt><dd class=\"mt-1 font-semibold\">AI-Assisted Marketing Workflows</dd></div></dl></div></div></section><section class=\"border-y border-slate-200 bg-slate-50 py-20 sm:py-24\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"max-w-3xl\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">What I Specialize In</p><h2 class=\"mt-3 text-3xl font-bold tracking-tight sm:text-4xl\">Skills that connect the full digital marketing workflow.</h2></div><div class=\"mt-12 grid gap-6 md:grid-cols-2\"><article class=\"rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg\"><span class=\"text-sm font-bold text-[#F68048]\">0<!-- -->1</span><h3 class=\"mt-5 text-xl font-bold\">Social Media Strategy</h3><p class=\"mt-3 leading-7 text-slate-600\">Develop platform-focused strategies, content plans, audience approaches, and social media workflows aligned with business objectives.</p></article><article class=\"rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg\"><span class=\"text-sm font-bold text-[#F68048]\">0<!-- -->2</span><h3 class=\"mt-5 text-xl font-bold\">Content Creation</h3><p class=\"mt-3 leading-7 text-slate-600\">Create social media graphics, short-form video, advertising creatives, banners, and AI-assisted visual content.</p></article><article class=\"rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg\"><span class=\"text-sm font-bold text-[#F68048]\">0<!-- -->3</span><h3 class=\"mt-5 text-xl font-bold\">Paid Advertising</h3><p class=\"mt-3 leading-7 text-slate-600\">Plan and optimize digital advertising campaigns with audience targeting, creative testing, campaign objectives, and performance analysis.</p></article><article class=\"rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg\"><span class=\"text-sm font-bold text-[#F68048]\">0<!-- -->4</span><h3 class=\"mt-5 text-xl font-bold\">Marketing Analytics</h3><p class=\"mt-3 leading-7 text-slate-600\">Use marketing data, analytics, reporting, and campaign insights to understand performance and support better decisions.</p></article></div></div></section><section class=\"py-20 sm:py-24\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"max-w-3xl\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Tools &amp; Platforms</p><h2 class=\"mt-3 text-3xl font-bold tracking-tight sm:text-4xl\">A practical toolkit for modern digital marketing.</h2><p class=\"mt-5 text-lg leading-8 text-slate-600\">I work with a combination of creative, advertising, analytics, and AI-powered tools to support different stages of the marketing process.</p></div><div class=\"mt-10 flex flex-wrap gap-3\"><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">ChatGPT</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">Canva Pro</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">Adobe Illustrator</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">After Effects</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">Premiere Pro</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">CapCut Pro</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">Google Analytics 4</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">Google Ads</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">Meta Ads</span><span class=\"rounded-full border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700\">Google Search Console</span></div></div></section><section class=\"relative overflow-hidden bg-[#1A2CA3] py-20 text-white sm:py-24\"><div class=\"absolute -right-32 -top-32 h-80 w-80 rounded-full bg-[#2845D6] opacity-60 blur-3xl\"></div><div class=\"absolute -bottom-32 -left-32 h-80 w-80 rounded-full bg-[#F68048] opacity-20 blur-3xl\"></div><div class=\"relative mx-auto max-w-4xl px-6 text-center lg:px-8\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Let&#x27;s Work Together</p><h2 class=\"mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl\">Have a digital marketing project in mind?</h2><p class=\"mx-auto mt-5 max-w-2xl text-lg leading-8 text-blue-100\">Let&#x27;s discuss your goals and explore how strategy, creativity, AI, and analytics can work together for your brand.</p><a class=\"mt-8 inline-flex rounded-lg bg-[#F68048] px-6 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:bg-[#e66f3b] hover:shadow-xl\" href=\"/contact\">Get in Touch</a></div></section></main><!--$--><!--/$--></div><footer class=\"bg-[#0D1A63] text-white\"><div class=\"mx-auto max-w-7xl px-6 py-14 sm:py-16 lg:px-8 lg:py-20\"><div class=\"grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-[1.6fr_1fr_1fr_1fr] lg:gap-x-12\"><div class=\"col-span-2 lg:col-span-1\"><a class=\"inline-block text-2xl font-bold tracking-tight\" href=\"/\">Takwah<span class=\"text-[#F68048]\"> Digital</span></a><p class=\"mt-5 max-w-md text-sm leading-7 text-blue-100 sm:text-base\">AI-powered social media strategy, content creation, digital marketing, paid advertising, and analytics for stronger digital brands.</p><a class=\"mt-7 inline-flex items-center justify-center rounded-lg bg-[#F68048] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#e66f3b]\" href=\"/contact\">Let&#x27;s Work Together</a></div><div><h2 class=\"text-xs font-bold uppercase tracking-[0.15em] text-white sm:text-sm\">Explore</h2><nav class=\"mt-5 flex flex-col gap-3\"><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/\">Home</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/about\">About</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/services\">Services</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/portfolio\">Portfolio</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/case-studies\">Case Studies</a></nav></div><div><h2 class=\"text-xs font-bold uppercase tracking-[0.15em] text-white sm:text-sm\">Resources</h2><nav class=\"mt-5 flex flex-col gap-3\"><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/articles\">Articles</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" h