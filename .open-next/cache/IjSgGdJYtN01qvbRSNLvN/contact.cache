{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/contact/layout,_N_T_/contact/page,_N_T_/contact"},"segmentPaths":["/_tree","/_full","/contact/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2_yzi-uknwj-2.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2eg0ks0feyohg.js\" async=\"\"></script><script src=\"/_next/static/chunks/3e4keds9ktjdu.js\" async=\"\"></script><script src=\"/_next/static/chunks/2gefo9ja1l2mo.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0rftioeh48hpg.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mpnoxox0-4cg.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/0h7q92cvb0d74.js\" async=\"\" crossorigin=\"\"></script><title>Contact | Takwah Digital | Takwah Digital</title><meta name=\"description\" content=\"Contact Takwah Digital for social media strategy, content creation, paid advertising, digital marketing, and marketing analytics services.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-white text-[#0D1A63]\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex min-h-screen flex-col\"><div class=\"flex-1\"><header class=\"sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur\"><nav class=\"mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8\"><a class=\"text-xl font-bold tracking-tight text-[#0D1A63]\" href=\"/\">Takwah<span class=\"text-[#F68048]\"> Digital</span></a><div class=\"hidden items-center gap-5 lg:flex\"><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/\">Home</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/about\">About</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/services\">Services</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/portfolio\">Portfolio</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/case-studies\">Case Studies</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/articles\">Articles</a><a class=\"relative py-2 text-sm font-medium transition text-slate-600 hover:text-[#2845D6]\" href=\"/certificates\">Certificates</a><a class=\"relative py-2 text-sm font-medium transition text-[#2845D6]\" href=\"/contact\">Contact<span class=\"absolute -bottom-1 left-0 right-0 mx-auto h-0.5 w-5 rounded-full bg-[#F68048]\"></span></a><a class=\"ml-2 rounded-lg bg-[#2845D6] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#1A2CA3]\" href=\"/contact\">Let&#x27;s Work Together</a></div><button type=\"button\" aria-label=\"Open menu\" aria-expanded=\"false\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-[#0D1A63] transition hover:bg-slate-50 lg:hidden\"><span class=\"sr-only\">Open menu</span><div class=\"space-y-1.5\"><span class=\"block h-0.5 w-5 bg-current transition \"></span><span class=\"block h-0.5 w-5 bg-current transition \"></span><span class=\"block h-0.5 w-5 bg-current transition \"></span></div></button></nav></header><main class=\"bg-white text-[#0D1A63]\"><section class=\"relative overflow-hidden bg-slate-50\"><div class=\"absolute -right-40 -top-40 h-96 w-96 rounded-full bg-[#2845D6]/10 blur-3xl\"></div><div class=\"absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-[#F68048]/10 blur-3xl\"></div><div class=\"relative mx-auto max-w-7xl px-6 py-20 sm:py-24 lg:px-8 lg:py-28\"><div class=\"max-w-4xl\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Contact Takwah Digital</p><h1 class=\"mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl\">Let&#x27;s build something<!-- --> <span class=\"text-[#2845D6]\">meaningful.</span></h1><p class=\"mt-6 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl\">Have a social media, content, advertising, or digital marketing project in mind? Tell me what you&#x27;re working on and what you want to achieve.</p></div></div></section><section class=\"py-20 sm:py-24\"><div class=\"mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[0.75fr_1.25fr] lg:px-8\"><div><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Start a Conversation</p><h2 class=\"mt-3 text-3xl font-bold tracking-tight sm:text-4xl\">Tell me what you need.</h2><p class=\"mt-5 leading-8 text-slate-600\">Whether you need ongoing social media support, creative content, advertising assistance, or marketing analytics, the first step is simply to tell me about your project.</p><div class=\"mt-10 space-y-5\"><div class=\"rounded-2xl border border-slate-200 bg-slate-50 p-6\"><p class=\"text-sm font-semibold uppercase tracking-wider text-[#F68048]\">Social Media</p><p class=\"mt-2 font-semibold text-[#0D1A63]\">Strategy, management &amp; content</p><p class=\"mt-2 text-sm leading-6 text-slate-600\">Build a stronger and more consistent social media presence.</p></div><div class=\"rounded-2xl border border-slate-200 bg-slate-50 p-6\"><p class=\"text-sm font-semibold uppercase tracking-wider text-[#F68048]\">Creative</p><p class=\"mt-2 font-semibold text-[#0D1A63]\">Design, video &amp; advertising creatives</p><p class=\"mt-2 text-sm leading-6 text-slate-600\">Create visual assets designed for digital platforms and marketing campaigns.</p></div><div class=\"rounded-2xl border border-slate-200 bg-slate-50 p-6\"><p class=\"text-sm font-semibold uppercase tracking-wider text-[#F68048]\">Analytics</p><p class=\"mt-2 font-semibold text-[#0D1A63]\">Measurement &amp; marketing insights</p><p class=\"mt-2 text-sm leading-6 text-slate-600\">Understand campaign performance and turn data into useful marketing decisions.</p></div></div><div class=\"mt-8\"><a class=\"inline-flex items-center font-semibold text-[#2845D6] transition hover:text-[#1A2CA3]\" href=\"/services\">Explore my services<span class=\"ml-2\">→</span></a></div></div><div class=\"rounded-3xl border border-slate-200 bg-white p-6 shadow-xl sm:p-8 lg:p-10\"><div class=\"mb-8\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Project Inquiry</p><h2 class=\"mt-3 text-2xl font-bold tracking-tight text-[#0D1A63] sm:text-3xl\">Tell me about your project</h2><p class=\"mt-3 leading-7 text-slate-600\">Share a few details about what you need. This will help me understand your goals and the type of support you are looking for.</p></div><form class=\"space-y-6\"><div><label for=\"name\" class=\"block text-sm font-semibold text-[#0D1A63]\">Name <span class=\"text-[#F68048]\">*</span></label><input id=\"name\" type=\"text\" required=\"\" placeholder=\"Your name\" class=\"mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#2845D6] focus:ring-2 focus:ring-[#2845D6]/10\" name=\"name\"/></div><div><label for=\"email\" class=\"block text-sm font-semibold text-[#0D1A63]\">Email <span class=\"text-[#F68048]\">*</span></label><input id=\"email\" type=\"email\" required=\"\" placeholder=\"you@example.com\" class=\"mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#2845D6] focus:ring-2 focus:ring-[#2845D6]/10\" name=\"email\"/></div><div><label for=\"company\" class=\"block text-sm font-semibold text-[#0D1A63]\">Company / Business</label><input id=\"company\" type=\"text\" placeholder=\"Company or business name\" class=\"mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#2845D6] focus:ring-2 focus:ring-[#2845D6]/10\" name=\"company\"/></div><div><label for=\"service\" class=\"block text-sm font-semibold text-[#0D1A63]\">Service Needed <span class=\"text-[#F68048]\">*</span></label><select id=\"service\" name=\"service\" required=\"\" class=\"mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2845D6] focus:ring-2 focus:ring-[#2845D6]/10\"><option value=\"\" disabled=\"\" selected=\"\">Select a service</option><option value=\"Social Media Strategy &amp; Management\">Social Media Strategy &amp; Management</option><option value=\"Content Creation &amp; Design\">Content Creation &amp; Design</option><option value=\"Paid Advertising\">Paid Advertising</option><option value=\"Marketing Analytics &amp; Reporting\">Marketing Analytics &amp; Reporting</option><option value=\"Digital Marketing\">Digital Marketing</option><option value=\"Other\">Other</option></select></div><div><label for=\"budget\" class=\"block text-sm font-semibold text-[#0D1A63]\">Estimated Budget</label><select id=\"budget\" name=\"budget\" class=\"mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2845D6] focus:ring-2 focus:ring-[#2845D6]/10\"><option value=\"\" disabled=\"\" selected=\"\">Select a budget range</option><option value=\"under-250\">Under $250</option><option value=\"250-500\">$250 – $500</option><option value=\"500-1000\">$500 – $1,000</option><option value=\"1000-2500\">$1,000 – $2,500</option><option value=\"2500-plus\">$2,500+</option><option value=\"not-sure\">Not sure yet</option></select></div><div><label for=\"message\" class=\"block text-sm font-semibold text-[#0D1A63]\">Project Details <span class=\"text-[#F68048]\">*</span></label><textarea id=\"message\" name=\"message\" required=\"\" rows=\"6\" placeholder=\"Tell me about your goals, audience, project requirements, timeline, or anything else that would be useful.\" class=\"mt-2 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#2845D6] focus:ring-2 focus:ring-[#2845D6]/10\"></textarea></div><button type=\"submit\" class=\"inline-flex w-full items-center justify-center rounded-xl bg-[#F68048] px-6 py-3.5 text-sm font-semibold text-white shadow-md transition hover:bg-[#e66f3b] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[#F68048] focus:ring-offset-2\">Send Project Inquiry</button><p class=\"text-center text-xs leading-5 text-slate-500\">This form is currently in preview mode. Secure submission and email/database notifications will be connected during the backend phase.</p></form></div></div></section><section class=\"border-y border-slate-200 bg-slate-50 py-20 sm:py-24\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"max-w-3xl\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">What Happens Next</p><h2 class=\"mt-3 text-3xl font-bold tracking-tight sm:text-4xl\">A simple process from inquiry to project.</h2></div><div class=\"mt-12 grid gap-6 md:grid-cols-3\"><article class=\"rounded-2xl border border-slate-200 bg-white p-7\"><span class=\"text-sm font-bold text-[#F68048]\">01</span><h3 class=\"mt-5 text-xl font-bold\">Tell me about your project</h3><p class=\"mt-3 leading-7 text-slate-600\">Share your goals, requirements, audience, timeline, and anything else that can help me understand the project.</p></article><article class=\"rounded-2xl border border-slate-200 bg-white p-7\"><span class=\"text-sm font-bold text-[#F68048]\">02</span><h3 class=\"mt-5 text-xl font-bold\">I review your requirements</h3><p class=\"mt-3 leading-7 text-slate-600\">I&#x27;ll consider the project scope and identify the most relevant strategy, creative, advertising, or analytics support.</p></article><article class=\"rounded-2xl border border-slate-200 bg-white p-7\"><span class=\"text-sm font-bold text-[#F68048]\">03</span><h3 class=\"mt-5 text-xl font-bold\">We discuss the next step</h3><p class=\"mt-3 leading-7 text-slate-600\">We can then discuss the project requirements, deliverables, timeline, and the best way to move forward.</p></article></div></div></section><section class=\"relative overflow-hidden bg-[#1A2CA3] py-20 text-white sm:py-24\"><div class=\"absolute -right-32 -top-32 h-80 w-80 rounded-full bg-[#2845D6] opacity-60 blur-3xl\"></div><div class=\"absolute -bottom-32 -left-32 h-80 w-80 rounded-full bg-[#F68048] opacity-20 blur-3xl\"></div><div class=\"relative mx-auto max-w-4xl px-6 text-center lg:px-8\"><p class=\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\">Takwah Digital</p><h2 class=\"mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl\">Ready to start a conversation?</h2><p class=\"mx-auto mt-5 max-w-2xl text-lg leading-8 text-blue-100\">Tell me about your goals and let&#x27;s explore how we can turn your digital marketing ideas into practical results.</p><a class=\"mt-8 inline-flex rounded-lg bg-[#F68048] px-6 py-3.5 text-sm font-semibold text-white shadow-lg transition hover:bg-[#e66f3b] hover:shadow-xl\" href=\"/portfolio\">View My Work</a></div></section></main><!--$--><!--/$--></div><footer class=\"bg-[#0D1A63] text-white\"><div class=\"mx-auto max-w-7xl px-6 py-14 sm:py-16 lg:px-8 lg:py-20\"><div class=\"grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-[1.6fr_1fr_1fr_1fr] lg:gap-x-12\"><div class=\"col-span-2 lg:col-span-1\"><a class=\"inline-block text-2xl font-bold tracking-tight\" href=\"/\">Takwah<span class=\"text-[#F68048]\"> Digital</span></a><p class=\"mt-5 max-w-md text-sm leading-7 text-blue-100 sm:text-base\">AI-powered social media strategy, content creation, digital marketing, paid advertising, and analytics for stronger digital brands.</p><a class=\"mt-7 inline-flex items-center justify-center rounded-lg bg-[#F68048] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#e66f3b]\" href=\"/contact\">Let&#x27;s Work Together</a></div><div><h2 class=\"text-xs font-bold uppercase tracking-[0.15em] text-white sm:text-sm\">Explore</h2><nav class=\"mt-5 flex flex-col gap-3\"><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/\">Home</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/about\">About</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/services\">Services</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/portfolio\">Portfolio</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/case-studies\">Case Studies</a></nav></div><div><h2 class=\"text-xs font-bold uppercase tracking-[0.15em] text-white sm:text-sm\">Resources</h2><nav class=\"mt-5 flex flex-col gap-3\"><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/articles\">Articles</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/certificates\">Certificates</a><a class=\"text-sm text-blue-100 transition hover:text-[#F68048]\" href=\"/contact\">Contact</a></nav></div>