{\"children\":\"Takwah Digital | AI-Powered Digital Marketing\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Takwah Digital — AI-powered social media strategy, content creation, paid advertising, digital marketing, and marketing analytics.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.2vob68tjqpejf.ico\",\"sizes\":\"256x256\",\"type\":\"image/x-icon\"}],[\"$\",\"$L17\",\"3\",{}]]\n18:I[62319,[\"/_next/static/chunks/1mpnoxox0-4cg.js\",\"/_next/static/chunks/433ulk1_q6vuc.js\"],\"default\"]\n19:I[34859,[\"/_next/static/chunks/1mpnoxox0-4cg.js\",\"/_next/static/chunks/433ulk1_q6vuc.js\"],\"default\"]\nf:[[\"$\",\"$L18\",null,{}],[\"$\",\"main\",null,{\"className\":\"min-h-screen bg-white text-[#0D1A63]\",\"children\":[[\"$\",\"section\",null,{\"className\":\"relative overflow-hidden bg-[#0D1A63] px-6 py-24 text-white lg:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute -right-32 -top-32 h-80 w-80 rounded-full bg-[#2845D6]/40 blur-3xl\"}],[\"$\",\"div\",null,{\"className\":\"absolute -bottom-32 -left-32 h-80 w-80 rounded-full bg-[#F68048]/20 blur-3xl\"}],[\"$\",\"div\",null,{\"className\":\"relative mx-auto max-w-7xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\",\"children\":\"Portfolio\"}],[\"$\",\"h1\",null,{\"className\":\"mt-4 max-w-4xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl\",\"children\":[\"Creative work built for\",\" \",[\"$\",\"span\",null,{\"className\":\"text-[#F68048]\",\"children\":\"digital growth.\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-6 max-w-3xl text-lg leading-8 text-blue-100 sm:text-xl\",\"children\":\"Explore selected work across social media content, advertising creatives, HTML5 banners, video, and digital marketing projects.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"px-6 py-20 sm:py-24 lg:px-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl\",\"children\":[\"$\",\"$L19\",null,{\"projects\":[{\"id\":1,\"title\":\"Baby Supper Shop - Grand Opening Campaign\",\"slug\":\"baby-supper-shop-grand-opening-campaign\",\"category\":\"Social Media\",\"client_name\":\"Baby Supper Shop\",\"short_description\":\"Grand opening social media campaign focused on awareness and engagement.\",\"description\":\"Created a promotional social media campaign for the Baby Supper Shop grand opening, using engaging visual creative and a 50% discount offer to attract attention and encourage audience engagement.\",\"challenge\":\"The campaign needed to create strong local awareness for the grand opening and encourage people to visit the shop while making the 50% discount offer attractive and easy to understand.\",\"strategy\":\"Use a simple, attention-grabbing social media creative built around the grand opening message and a strong 50% discount offer, with a friendly and playful visual style designed to attract local audiences.\",\"execution\":\"Developed the grand opening social media creative with a clear promotional message, playful visual elements, and the 50% discount offer as the main attention point. The creative was prepared for social media campaign use to support awareness and engagement.\",\"results\":\"The campaign provided a clear and engaging promotional message for the grand opening, with the 50% discount helping create a strong promotional hook. The project was designed to support local awareness, audience engagement, and showroom or shop visits.\",\"featured_media_id\":1,\"project_url\":null,\"project_date\":\"2026-04-10 to 2026-05-09\",\"is_featured\":1,\"is_published\":1,\"seo_title\":null,\"seo_description\":null,\"created_at\":\"2026-08-18 14:35:27\",\"updated_at\":\"2026-08-18 14:35:27\",\"featured_media_file_name\":\"baby-super-shop-1.jpg\",\"featured_media_storage_key\":\"portfolio/baby-supper-shop/baby-super-shop-1.jpg\",\"featured_media_alt_text\":\"Baby Supper Shop Grand Opening Campaign\",\"featured_media_caption\":\"Baby Supper Shop grand opening campaign creative with 50% discount offer.\"},{\"id\":2,\"title\":\"Shishir Honda - Social Media Marketing Campaign\",\"slug\":\"shishir-honda-social-media-marketing-campaign\",\"category\":\"Social Media\",\"client_name\":\"Shishir Honda\",\"short_description\":\"Social media marketing campaign focused on increasing showroom visits and generating sales leads.\",\"description\":\"Created a social media marketing campaign for Shishir Honda in Chapai Nawabganj, designed to increase local brand awareness, encourage showroom visits, and generate qualified sales leads.\",\"challenge\":\"The main challenge was to build stronger local awareness for Shishir Honda, attract attention from potential motorcycle buyers in the Chapai Nawabganj market, and turn social media engagement into meaningful showroom interest and sales opportunities.\",\"strategy\":\"The strategy focused on using social media to communicate the brand consistently to a local audience, showcase Honda motorcycles and promotional content, strengthen brand visibility, and create clear pathways from social media interest to showroom visits and sales conversations.\",\"execution\":\"The campaign was executed through social media content and promotional creatives designed for the local market. Content was developed to present Honda products clearly, maintain consistent brand communication, highlight promotional opportunities, and encourage prospective customers to take the next step toward contacting or visiting the showroom.\",\"results\":\"The campaign strengthened Shishir Honda’s local social media presence, improved the consistency of product and promotional communication, and created a stronger connection between online audience interest and showroom-focused customer engagement. The work established a practical social media foundation for ongoing local marketing and lead generation.\",\"featured_media_id\":2,\"project_url\":null,\"project_date\":\"2026\",\"is_featured\":0,\"is_published\":1,\"seo_title\":null,\"seo_description\":null,\"created_at\":\"2026-08-18 15:34:16\",\"updated_at\":\"2026-08-18 15:34:16\",\"featured_media_file_name\":\"shishir-honda-1.png\",\"featured_media_storage_key\":\"portfolio/shishir-honda/shishir-honda-1.png\",\"featured_media_alt_text\":\"Shishir Honda Social Media Marketing Campaign\",\"featured_media_caption\":\"Shishir Honda social media marketing campaign creative.\"}]}]}]}],\"$L1a\"]}]]\n1a:[\"$\",\"section\",null,{\"className\":\"bg-slate-50 px-6 py-20 sm:py-24 lg:px-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold uppercase tracking-[0.2em] text-[#F68048]\",\"children\":\"Have a Project?\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 text-3xl font-bold tracking-tight sm:text-4xl\",\"children\":\"Let's create something that gets attention.\"}],[\"$\",\"p\",null,{\"className\":\"mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600\",\"children\":\"Tell me about your project, campaign, or creative requirements and let's explore the right digital marketing approach.\"}],[\"$\",\"$L4\",null,{\"href\":\"/contact\",\"className\":\"mt-8 inline-flex rounded-lg bg-[#F68048] px-6 py-3.5 text-sm font-semibold text-white shadow-md transition hover:bg-[#e66f3b] hover:shadow-lg\",\"children\":\"Start a Project\"}]]}]}]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/2_yzi-uknwj-2.css\",\"style\"]\n:HL[\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"tree\":{\"name\":\"\",\"param\":null,\"prefetchHints\":4176,\"slots\":{\"children\":{\"name\":\"portfolio\",\"param\":null,\"prefetchHints\":4192,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"param\":null,\"prefetchHints\":4256,\"slots\":null}}}}},\"staleTime